# Python venvs (gigabytes — fetched/built per machine)
.venv/
lion_env/
admet_env/

# External model repository — keep model checkpoints, ignore bulk data
lion_repo/data/all_data.csv
lion_repo/data/all_data_for_paper.csv
lion_repo/.git/

# Byte-compiled
__pycache__/
*.pyc
*.pyo

# Local caches (regenerable)
.cache/

# IDE
.idea/
.vscode/
*.swp

# Claude Code agent settings (local-only — not source)
.claude/

# OS junk
.DS_Store
Thumbs.db

# Redundant — the IAJD_master/ directory is the source of truth
IAJD_master.zip

# Repair backups (large, regeneratable)
*.pre_repair_backup.pkl

# Test outputs that the loop regenerates
/tmp/iajd_server*.log

# Runtime logs / dumps the user might generate
*.log

# Workflow snapshots — local checkpoints, not part of source
workflow_snapshot_*/

# External tool repositories cloned next to the project
external_corpus_v1/
agile_repo/

# Dataset backups / expansions (regenerable from canonical xlsx)
IAJD_master/datasets/*.bak_pre_*
IAJD_master/datasets/*_backup.xlsx
IAJD_master/datasets/*_expanded.xlsx

# Debug / ad-hoc dev scripts (not runtime)
audit_datasets.py
build_diagnostic.py
fix_and_rebuild.py
rebuild_pka_model.py
expand_datasets.py

# Local debug outputs (regenerable; not part of the trained pipeline)
proposed_iajds*.csv
proposed_iajds*.json
proposed_iajd*.csv
proposed_iajd*.json
molgpka_live_audit.json
agile_embeddings_*.npy

# Plots / screenshots (regenerated from the live model)
*.png

# Local physics scratch
physics_pka_v1/

# Physics MD working dir — large transient GROMACS trajectories, deleted after
# observable extraction. Not source; caches live in bundles_caches/physics/.
physics_cache/

# pytest cache
.pytest_cache/
