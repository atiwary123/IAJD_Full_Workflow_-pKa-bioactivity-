; Titratable DLin-MC3-DMA (MC3T) for titratable-Martini-3 constant-pH MD.
;
; Built from the fixed-charge MC3 (martini/ionizable/MC3/MC3.itp, Kjolbye et al. JCTC
; 2026) by replacing the tertiary-amine head bead N1 (TN3a) with the calibrated
; titratable dimethylamine head motif from DMEA (molecules.itp): P2 (N2_10.2, intrinsic
; aqueous pKa 10.2) + D (DB1) + DP (DB2, proton site). The rest of MC3 (glycerol/ester
; linker GLA/CX + two di-unsaturated linoleyl tails) is preserved with tail macros
; expanded to explicit values. Use with the titratable martini.itp force field (PME,
; eps_r=6) and convert_gro_to_titratable.py to add the dummy-proton geometry on P2.
;
; HONEST CAVEAT: this is a reasonable head-substitution (DMEA is exactly MC3's
; dimethylamino head), but the N1(TN3a, T-size) -> P2(N2_10.2, R-size) swap and the
; reused N1-CN bond/angle are an approximation of a fully re-calibrated titratable
; lipid; the intrinsic head is the calibrated N2_10.2 (pKa 10.2), and the MEMBRANE
; titration measures the apparent (shifted) pKa.

[ moleculetype ]
; name  nrexcl
  MC3T  1

[ atoms ]
; nr  type      resnr residue atom  cgnr  charge  mass
  1   N2_10.2   1     MC3T    P2    1     -1.00
  2   DB1       1     MC3T    D     2      0.00
  3   DB2       1     MC3T    DP    3     +1.00
  4   TC2       1     MC3T    CN    4      0       36
  5   SN4a      1     MC3T    GLA   5      0       54
  6   SC2       1     MC3T    CX    6      0       54
  7   C1        1     MC3T    C1A   7      0       72
  8   C4h       1     MC3T    D2A   8      0       72
  9   C4h       1     MC3T    D3A   9      0       72
 10   C1        1     MC3T    C4A  10      0       72
 11   C1        1     MC3T    C1B  11      0       72
 12   C4h       1     MC3T    D2B  12      0       72
 13   C4h       1     MC3T    D3B  13      0       72
 14   C1        1     MC3T    C4B  14      0       72

[ bonds ]
; head titratable motif (from DMEA): P2-DP proton bond
  1    3    1   0.000   4000
; MC3 body (N1->P2 head retained), tail macros expanded (b_C1_C4=b_C4_C4=0.47/3800)
  1    4    1   0.34    5000   ; P2(N1)-CN
  4    5    1   0.365   5000   ; CN-GLA
  5    6    1   0.365   5000   ; GLA-CX
  6    7    1   0.47    5000   ; CX-C1A
  6   11    1   0.47    5000   ; CX-C1B
  7    8    1   0.47    3800   ; C1A-D2A
  8    9    1   0.47    3800   ; D2A-D3A
  9   10    1   0.47    3800   ; D3A-C4A
 11   12    1   0.47    3800   ; C1B-D2B
 12   13    1   0.47    3800   ; D2B-D3B
 13   14    1   0.47    3800   ; D3B-C4B

[ constraints ]
; head dummy D held off P2 (from DMEA)
  1    2    1   0.200

[ angles ]
; head (MC3 explicit, funct 1)
  1    4    5    1   155   15    ; P2(N1)-CN-GLA
  4    5    6    1   130   20    ; CN-GLA-CX
  5    6   11    1   110   15    ; GLA-CX-C1B
  5    6    7    1   110   15    ; GLA-CX-C1A
  7    6   11    1   125   25    ; C1A-CX-C1B
  6    7    8    1   140   15    ; CX-C1A-D2A
  6   11   12    1   140   15    ; CX-C1B-D2B
; tails (a_C1_C4_C4 = a_C4_C4_C1 = 100/10, funct 2)
  7    8    9    2   100   10    ; C1A-D2A-D3A
  8    9   10    2   100   10    ; D2A-D3A-C4A
 11   12   13    2   100   10    ; C1B-D2B-D3B
 12   13   14    2   100   10    ; D2B-D3B-C4B

[ exclusions ]
; head dummies mutually excluded from P2 and each other (nrexcl=1 + explicit)
  1    2    3
  2    3
; preserve MC3's tail cross-exclusion (renumbered 5->7, 9->11)
  7   11

[ pairs ]
  7   11   1   4.100000e-01   2.350000e+00
